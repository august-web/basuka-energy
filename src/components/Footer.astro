---
import { t, type Lang, localizedHref } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const nav = [
  { key: 'about', href: '/about-us-2/' },
  { key: 'partners', href: '/partners/' },
  { key: 'howItWorks', href: '/how-it-works/' },
  { key: 'academy', href: '/academy/' },
  { key: 'impact', href: '/impact/' },
  { key: 'services', href: '/services/' },
  { key: 'contact', href: '/contact-us/' },
] as const;
const year = new Date().getFullYear();
---

<footer class="bg-brand-navy text-slate-300">
  <div class="weave-strip" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col items-start gap-4 rounded-2xl border border-white/10 bg-white/5 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-brand-cream">{ui.newsletterTitle}</h3>
        <p class="mt-1 text-sm text-slate-400">{ui.newsletterDesc}</p>
      </div>
      <form id="newsletter-form" class="flex w-full max-w-md gap-2" data-email="info@basukaenergy.com" data-whatsapp="12149951927">
        <input
          type="email"
          name="email"
          required
          data-label="Email"
          class="w-full rounded-full border border-white/15 bg-white/10 px-5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-brand-cream/40 focus:bg-white/15"
          placeholder={ui.newsletterPlaceholder}
          aria-label={ui.newsletterEmailLabel}
        />
        <button
          type="submit"
          class="btn-shine shrink-0 rounded-full bg-brand-green px-6 py-2.5 text-sm font-bold text-white transition hover:bg-brand-green-dark"
        >
          {ui.newsletterSubscribe}
        </button>
      </form>
      <p id="newsletter-success" class="hidden text-sm font-medium text-brand-cream">{ui.newsletterSuccess}</p>
    </div>
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <img src="/assets/logo.png" alt="BaSuka Energy logo" class="h-12 w-auto transition-transform duration-300 hover:scale-105" width="180" height="48" decoding="async" />
        <p class="mt-5 max-w-xs text-sm leading-6">
          {ui.footerBlurb}
        </p>
        <a
          href="https://wa.me/12149951927"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-brand-cream hover:text-brand-cream"
        >
          <span class="relative inline-block h-2 w-2 rounded-full bg-brand-green" aria-hidden="true">
            <span class="absolute inset-0 animate-ping rounded-full bg-brand-green opacity-75"></span>
          </span>
          WhatsApp +1 (214) 995-1927
        </a>
        <div class="mt-6 flex items-center gap-3">
          <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="BaSuka Energy on LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-slate-400 transition hover:border-brand-cream/40 hover:text-brand-cream">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.3 18.3V10H5.7v8.3h2.6zM7 8.8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm11.3 9.5v-4.5c0-2.4-1.3-3.5-3-3.5-1.4 0-2 .8-2.3 1.3v-1.1h-2.6v8.3h2.6v-4.6c0-.9.2-1.7 1.3-1.7s1.1 1 1.1 1.7v4.6h2.6z" /></svg>
          </a>
          <a href="https://wa.me/12149951927" target="_blank" rel="noopener noreferrer" aria-label="BaSuka Energy on WhatsApp" class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-slate-400 transition hover:border-brand-cream/40 hover:text-brand-cream">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1s-.5-.2-.7.2-.8 1-.9 1.1-.3.2-.6 0c-1.5-.7-2.4-1.3-3.4-3-.3-.5.3-.5.7-1.5.1-.2 0-.4 0-.5L9.4 7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.8.4C7 7 6 8 6 10c0 2.3 1.7 4.5 1.9 4.8.2.3 3.3 5 8 7 1.2.5 2 .8 2.7.9.6.1 1.2.1 1.6 0 .5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.3-.6-.4z M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.3A10 10 0 1 0 12 2z" /></svg>
          </a>
          <a href="mailto:info@basukaenergy.com" aria-label="Email BaSuka Energy" class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-slate-400 transition hover:border-brand-cream/40 hover:text-brand-cream">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H3zm0 2h.5L12 12l8.5-5h.5v.5l-8.5 5-8.5-5V7zm0 1.5L8.5 12 3 16v-7.5zm18 0V16l-5.5-4L21 8.5z" /></svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream">{ui.footerExplore}</h3>
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={localizedHref(item.href, lang)} class="link-sweep transition-colors hover:text-brand-cream">
                  {ui.nav[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream">{ui.footerContact}</h3>
        <ul class="mt-5 space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 2a6 6 0 0 1 6 6c0 4.5-6 10-6 10S4 12.5 4 8a6 6 0 0 1 6-6zm0 8a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            Ouagadougou, Burkina Faso
          </li>
          <li>
            <a href={localizedHref('/contact-us/', lang)} class="link-sweep transition-colors hover:text-brand-cream">{ui.getInTouch}</a>
          </li>
        </ul>
        <p class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4 text-xs leading-5 text-slate-400">
          {ui.footerNote}
        </p>
      </div>
    </div>

    <p class="mt-16 select-none text-center font-display text-[13vw] font-bold leading-none tracking-tight text-white/5 sm:text-[9vw]" aria-hidden="true">
      BASUKA ENERGY
    </p>

    <div class="mt-4 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row">
      <p>&copy; {year} BaSuka Energy. {ui.footerRights}</p>
      <p>{ui.footerTagline}</p>
    </div>
  </div>
</footer>

<script>
  // Newsletter form: deliver by email to info@, WhatsApp only as fallback.
  const nlForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const nlSuccess = document.getElementById('newsletter-success');
  nlForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (new FormData(nlForm).get('email') ?? '').toString().trim();
    const number = nlForm.getAttribute('data-whatsapp') ?? '12149951927';
    const dest = nlForm.getAttribute('data-email') ?? '';
    const text = `Newsletter subscription\nEmail: ${email}`;
    const waUrl = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
    const showSuccess = () => {
      nlSuccess?.classList.remove('hidden');
      nlForm.classList.add('hidden');
    };
    if (dest) {
      const apiBase = location.hostname === 'basukaenergy.com'
        ? 'https://www.basukaenergy.com'
        : '';
      fetch(apiBase + '/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          to: dest,
          email,
          context: 'Newsletter subscription',
          message: text,
        }),
      })
        .then((res) => {
          if (!res.ok) throw new Error('Delivery failed');
          showSuccess();
        })
        .catch(() => {
          nlSuccess?.classList.remove('hidden');
          nlForm.classList.add('hidden');
        });
      return;
    }
    window.open(waUrl, '_blank', 'noopener');
    showSuccess();
  });
</script>
