---
const nav = [
  { label: 'About us', href: '/about-us-2/' },
  { label: 'Partners', href: '/partners/' },
  { label: 'How it works', href: '/how-it-works/' },
  { label: 'Academy', href: '/academy/' },
  { label: 'Impact', href: '/impact/' },
  { label: 'Services', href: '/services/' },
  { label: 'Contact us', href: '/contact-us/' },
];
const year = new Date().getFullYear();
---

<footer class="bg-brand-navy text-slate-300">
  <div class="weave-strip" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <img src="/assets/logo.png" alt="Ba-Suka Energy logo" class="h-12 w-auto rounded-lg bg-white/95 p-1.5" width="190" height="48" />
        <p class="mt-5 max-w-xs text-sm leading-6">
          Burkina Faso's smart electricity network — affordable power through smart, swappable SIRA™ batteries and 100% solar-powered Swap &amp; Glow™ stations.
        </p>
        <a
          href="https://wa.me/22666384592"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-brand-cream hover:text-brand-cream"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-brand-green" aria-hidden="true"></span>
          WhatsApp +226 66 38 45 92
        </a>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream">Explore</h3>
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="link-sweep transition-colors hover:text-brand-cream">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream">Contact</h3>
        <ul class="mt-5 space-y-3 text-sm">
          <li>Ouagadougou, Burkina Faso</li>
          <li>
            <a href="/contact-us/" class="link-sweep transition-colors hover:text-brand-cream">Get in touch</a>
          </li>
        </ul>
        <p class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4 text-xs leading-5 text-slate-400">
          Building Africa's first women-led smart electricity network — launching September 2026.
        </p>
      </div>
    </div>

    <p class="mt-16 select-none text-center font-display text-[13vw] font-bold leading-none tracking-tight text-white/5 sm:text-[9vw]" aria-hidden="true">
      BA-SUKA
    </p>

    <div class="mt-4 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row">
      <p>&copy; {year} Ba-Suka Energy. All rights reserved.</p>
      <p>Smart electricity where the grid fails.</p>
    </div>
  </div>
</footer>
