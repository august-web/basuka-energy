---
// Renders a page's section list (from src/data/*.json) by dispatching on `type`.
// In headings, *words* are rendered in the serif accent style for editorial emphasis.
import { t, type Lang, localizedHref } from '../i18n/ui';
import OptimizedImage from './OptimizedImage.astro';
import { resolveImage, type ImageMetadata } from '../utils/images';
interface Cta {
  label: string;
  href?: string;
}
interface FormField {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'select' | 'textarea';
  required?: boolean;
  placeholder?: string;
  options?: string[];
  span?: 1 | 2;
}
interface Section {
  type: string;
  id?: string;
  eyebrow?: string;
  heading?: string;
  heading2?: string;
  subheading?: string;
  intro?: string;
  body?: string | string[];
  image?: string;
  backgroundImage?: string;
  items?: any[];
  cards?: any[];
  ctas?: Cta[];
  images?: string[];
  mapEmbed?: string;
  variant?: string;
  chips?: string[];
  citation?: string;
  breadcrumb?: string[];
  bullets?: string[];
  pillars?: string[];
  form?: boolean;
  fields?: FormField[];
  context?: string;
  whatsapp?: string;
  submitLabel?: string;
  successText?: string;
}
interface Props {
  sections: Section[];
  lang?: Lang;
}
const { sections, lang = 'en' } = Astro.props;
const ui = t(lang);
const paragraphs = (body: Section['body']) =>
  Array.isArray(body) ? body : body ? [body] : [];
// Multi-line bodies are bullet lists; single paragraphs stay prose.
// Explicit `bullets` arrays on the item take precedence over body parsing.
const listItems = (item: any) =>
  Array.isArray(item?.bullets) && item.bullets.length > 0
    ? item.bullets.map((b: string) => String(b).trim()).filter(Boolean)
    : typeof item?.body === 'string' && item.body.includes('\n')
      ? item.body.split('\n').filter(Boolean).map((b: string) => b.replace(/^[→•·\-*\s.]+/, '').trim()).filter(Boolean)
      : null;
// Split "word *accent* rest" on asterisks -> fragments for accent styling
const accentify = (text?: string) =>
  (text ?? '').split(/\*(.+?)\*/g).map((part, i) => ({ text: part, accent: i % 2 === 1 }));
let eyebrowCounter = 0;
const nextEyebrowNumber = () => String(++eyebrowCounter).padStart(2, '0');
// Match a contact label to an icon type for visual context
const contactIcon = (label: string): 'location' | 'phone' | 'email' | 'office' | null => {
  const l = label.toLowerCase();
  if (l.includes('email') || l.includes('mail')) return 'email';
  if (l.includes('phone')) return 'phone';
  if (l.includes('office')) return 'office';
  if (l.includes('location') || l.includes('address')) return 'location';
  return null;
};
// Slugify a heading for use as a section anchor ID (explicit `id` wins)
const sectionId = (section: Section, idx: number): string | undefined => {
  if (section.id) return section.id;
  const raw = section.heading ?? section.eyebrow ?? section.type;
  if (section.type === 'hero') return undefined; // hero is always first, no ID needed
  const slug = raw.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return slug ? slug.slice(0, 60) : `section-${idx}`;
};
---

{
  sections.map((section, idx) => {
    const tinted = idx % 2 === 1;
    switch (section.type) {
      case 'hero':
        // Full-bleed background variant: image covers the whole hero behind
        // the headline (same asset on desktop and mobile), with a navy scrim
        // layered on top so white text stays readable.
        if (section.backgroundImage) {
          return (
            <section class="relative isolate overflow-hidden bg-brand-navy">
              <OptimizedImage
                src={section.backgroundImage}
                alt=""
                class="absolute inset-0 h-full w-full object-cover"
                widths={[480, 768, 1200, 1920]}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
              />
              {/* Legibility scrims: deeper on the left/bottom for desktop copy,
                  heavier at the bottom for stacked mobile copy. */}
              <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/85 via-brand-navy/45 to-brand-navy/10" aria-hidden="true" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/25 to-brand-navy/20" aria-hidden="true" />
              <div class="relative mx-auto flex min-h-[36rem] max-w-7xl items-center px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
                <div class="max-w-2xl">
                  {section.eyebrow && (
                    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-cream/30 bg-brand-navy/50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-brand-cream backdrop-blur-sm">
                      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-cream" aria-hidden="true" />
                      {section.eyebrow}
                    </p>
                  )}
                  <h1 class="text-4xl font-bold leading-[1.05] text-white drop-shadow-md sm:text-6xl lg:text-[4.25rem]">
                    {accentify(section.heading).map((part) =>
                      part.accent ? <span class="accent-serif text-brand-cream">{part.text}</span> : part.text
                    )}
                  </h1>
                  {section.heading2 && (
                    <p class="mt-3 text-lg font-medium text-brand-cream/90 sm:text-xl">{section.heading2}</p>
                  )}
                  {paragraphs(section.body).map((p) => (
                    <p class="mt-6 max-w-xl text-lg leading-8 text-slate-100 drop-shadow-sm">{p}</p>
                  ))}
                  {section.chips && (
                    <ul class="mt-6 flex flex-wrap gap-2">
                      {section.chips.map((chip: string) => (
                        <li class="rounded-full border border-white/25 bg-brand-navy/50 px-4 py-1.5 text-sm font-medium text-brand-cream backdrop-blur-sm transition-colors hover:border-brand-cream/40 hover:bg-brand-navy/70">{chip}</li>
                      ))}
                    </ul>
                  )}
                  {section.ctas && section.ctas.length > 0 && (
                    <div class="mt-9 flex flex-wrap gap-3">
                      {section.ctas.map((cta, i) => (
                        <a
                          href={cta.href ?? '/contact-us/'}
                          class:list={[
                            'group inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold transition',
                            i === 0
                              ? 'btn-shine bg-brand-green text-white shadow-lg shadow-brand-green/30 hover:bg-brand-green-dark'
                              : 'border border-white/40 bg-brand-navy/30 text-white backdrop-blur-sm hover:border-brand-cream hover:text-brand-cream',
                          ]}
                        >
                          {cta.label}
                          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          );
        }
        return (
          <section class="relative overflow-hidden bg-brand-navy">
            <div class="pointer-events-none absolute -top-40 -left-40 h-96 w-96 rounded-full bg-brand-green/20 blur-3xl" aria-hidden="true" />
            <div class="pointer-events-none absolute -right-32 -bottom-32 h-80 w-80 rounded-full bg-brand-cream/10 blur-3xl" aria-hidden="true" />
            <div class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(#fcde9e 1px, transparent 1px); background-size: 26px 26px;" aria-hidden="true" />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-brand-navy/40" aria-hidden="true" />
            <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
              <div>
                {section.breadcrumb && section.breadcrumb.length > 0 && (
                  <nav aria-label="Breadcrumb" class="mb-5">
                    <ol class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-400">
                      {section.breadcrumb.map((crumb: string, i: number) => (
                        <li class="flex items-center gap-2">
                          {i < section.breadcrumb!.length - 1 ? (
                            <>
                              <a href={localizedHref('/', lang)} class="transition-colors hover:text-brand-cream">{ui.nav.home}</a>
                              <svg class="h-3 w-3 text-slate-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.3 5.3a1 1 0 0 1 1.4 0l4 4a1 1 0 0 1 0 1.4l-4 4a1 1 0 0 1-1.4-1.4L10.6 10 7.3 6.7a1 1 0 0 1 0-1.4z" clip-rule="evenodd" />
                              </svg>
                            </>
                          ) : (
                            <span class="text-brand-cream" aria-current="page">{crumb}</span>
                          )}
                        </li>
                      ))}
                    </ol>
                  </nav>
                )}
                {section.eyebrow && (
                  <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-cream/30 bg-brand-green/15 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-brand-cream">
                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-cream" aria-hidden="true" />
                    {section.eyebrow}
                  </p>
                )}
                <h1 class="text-4xl font-bold leading-[1.05] text-white sm:text-6xl lg:text-[4.25rem]">
                  {accentify(section.heading).map((part) =>
                    part.accent ? <span class="accent-serif text-brand-cream">{part.text}</span> : part.text
                  )}
                </h1>
                {section.heading2 && (
                  <p class="mt-3 text-lg font-medium text-brand-cream/80 sm:text-xl">{section.heading2}</p>
                )}
                {paragraphs(section.body).map((p) => (
                  <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">{p}</p>
                ))}
                {section.chips && (
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {section.chips.map((chip: string) => (
                      <li class="rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-brand-cream transition-colors hover:border-brand-cream/40 hover:bg-white/10">{chip}</li>
                    ))}
                  </ul>
                )}
                {section.ctas && section.ctas.length > 0 && (
                  <div class="mt-9 flex flex-wrap gap-3">
                    {section.ctas.map((cta, i) => (
                      <a
                        href={cta.href ?? '/contact-us/'}
                        class:list={[
                          'group inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold transition',
                          i === 0
                            ? 'btn-shine bg-brand-green text-white shadow-lg shadow-brand-green/30 hover:bg-brand-green-dark'
                            : 'border border-white/25 text-white hover:border-brand-cream hover:text-brand-cream',
                        ]}
                      >
                        {cta.label}
                        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              {section.image && (
                <div class="relative lightbox-trigger cursor-pointer">
                  <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-brand-green/30 to-brand-cream/20 blur-2xl" aria-hidden="true" />
                  <OptimizedImage
                    src={section.image}
                    alt={section.heading ?? 'BaSuka Energy'}
                    class="relative w-full rotate-1 rounded-3xl shadow-2xl ring-1 ring-white/10 transition duration-500 hover:rotate-0"
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              )}
              {!section.image && section.images && section.images.length > 0 && (
                <div class="relative">
                  <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-brand-green/30 to-brand-cream/20 blur-2xl" aria-hidden="true" />
                  <div class="relative grid grid-cols-2 gap-3">
                    <OptimizedImage
                      src={section.images[0]}
                      alt={section.heading ?? 'BaSuka Energy'}
                      class="col-span-2 w-full rotate-1 rounded-3xl shadow-2xl ring-1 ring-white/10 transition duration-500 hover:rotate-0"
                      loading="eager"
                      fetchpriority="high"
                    />
                    {section.images.slice(1).map((src: string) => (
                      <OptimizedImage src={src} alt="" class:list={['aspect-video w-full rounded-2xl object-cover shadow-lg ring-1 ring-white/10 transition duration-300 hover:scale-[1.03]', section.images!.length === 2 && 'col-span-2']} loading="lazy" />
                    ))}
                  </div>
                </div>
              )}
            </div>
          </section>
        );

      case 'marquee':
        return (
          <section class="weave-strip-container relative overflow-hidden border-y border-brand-navy/10 bg-brand-cream py-4">
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-brand-cream to-transparent" aria-hidden="true" />
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-brand-cream to-transparent" aria-hidden="true" />
            <div class="marquee" aria-hidden="true">
              <div class="marquee-track">
                {[0, 1].map((copy) => (
                  <ul class="flex shrink-0 items-center gap-10 pr-10 text-sm font-bold uppercase tracking-[0.18em] text-brand-navy">
                    {section.items?.map((item: any) => (
                      <li class="flex items-center gap-10 whitespace-nowrap">
                        {item}
                        <svg class="h-3.5 w-3.5 text-brand-green" viewBox="0 0 20 20" fill="currentColor"><path d="M10 0l2.4 7.6L20 10l-7.6 2.4L10 20l-2.4-7.6L0 10l7.6-2.4z" /></svg>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
            <p class="sr-only">{section.items?.join(' · ')}</p>
          </section>
        );

      case 'quote':
        return (
          <section id={sectionId(section, idx)} class="relative overflow-hidden bg-brand-paper py-20 lg:py-28">
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-64 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-green/5 blur-3xl" aria-hidden="true" />
            <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
              <svg class="mx-auto h-10 w-10 text-brand-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9.6 4C6 6 3.5 9.4 3.5 13.9c0 3.4 2 5.6 4.7 5.6 2.4 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.8-3.7-3.8-.4 0-1 .1-1.1.2.4-2.3 2.3-4.7 4.3-5.9L9.6 4zm10 0c-3.6 2-6.1 5.4-6.1 9.9 0 3.4 2 5.6 4.7 5.6 2.4 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.8-3.7-3.8-.4 0-1 .1-1.1.2.4-2.3 2.3-4.7 4.3-5.9L19.6 4z" />
              </svg>
              <blockquote class="accent-serif mt-6 text-2xl leading-snug text-brand-navy sm:text-3xl lg:text-4xl">
                {section.body}
              </blockquote>
              {section.citation && (
                <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-brand-green-dark">{section.citation}</p>
              )}
            </div>
          </section>
        );

      case 'cards':
        return (
          <section id={sectionId(section, idx)} class:list={['py-20 lg:py-24', tinted ? 'bg-brand-cream-light/70' : 'bg-white']}>
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
              {section.eyebrow && (
                <p class="eyebrow-rule mb-3 justify-center">
                  <span class="ghost-numeral text-xl">{nextEyebrowNumber()}</span>
                  {section.eyebrow}
                </p>
              )}
              {section.heading && (
                <h2 class="mx-auto max-w-3xl text-center text-3xl font-bold sm:text-4xl lg:text-[2.75rem] lg:leading-[1.15]">
                  {accentify(section.heading).map((part) =>
                    part.accent ? <span class="accent-serif text-brand-green-dark">{part.text}</span> : part.text
                  )}
                </h2>
              )}
              {section.intro && <p class="mx-auto mt-4 max-w-3xl text-center text-lg leading-8 text-slate-600">{section.intro}</p>}
              {section.subheading && <p class="mt-6 text-center text-xs font-bold uppercase tracking-[0.2em] text-brand-green-dark">{section.subheading}</p>}
              {section.image && (
                <div class="img-zoom fade-in mt-8 overflow-hidden rounded-2xl">
                  <OptimizedImage src={section.image} alt="" class="aspect-[16/7] w-full object-cover" loading="lazy" />
                </div>
              )}
              <div class:list={['mt-12 grid gap-6', section.items && section.items.length > 4 ? 'sm:grid-cols-2 lg:grid-cols-3' : section.items && section.items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3']}>
                {section.items?.map((item, i) => {
                  const bullets = listItems(item);
                  return (
                    <div class="card-corner reveal group relative overflow-hidden rounded-2xl border border-brand-navy/8 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-brand-green/30 hover:shadow-xl hover:shadow-brand-navy/5">
                      <div class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-brand-green to-brand-cream transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true" />
                      {item.iconImage && (
                        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-green/10 transition-transform duration-300 group-hover:scale-110">
                          <OptimizedImage src={item.iconImage} alt="" class="h-9 w-9 object-contain" loading="lazy" />
                        </div>
                      )}
                      {item.image && (
                        <div class="card-img-overlay fade-in lightbox-trigger mb-5 cursor-pointer rounded-xl">
                          <OptimizedImage src={item.image} alt={item.title ?? ''} class="aspect-[4/3] w-full rounded-xl object-cover" loading="lazy" />
                          <span class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full bg-white/80 text-brand-navy opacity-0 shadow-sm backdrop-blur transition group-hover:opacity-100">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" /></svg>
                          </span>
                        </div>
                      )}
                      {!item.iconImage && !item.image && item.title && (
                        <p class="ghost-numeral text-5xl transition-opacity duration-300 group-hover:opacity-70">{String(i + 1).padStart(2, '0')}</p>
                      )}
                      {item.title && <h3 class="mt-4 text-xl font-semibold">{item.title}</h3>}
                      {item.subtitle && <p class="mt-1 text-sm font-medium text-slate-500">{item.subtitle}</p>}
                      {item.focus && <p class="mt-2 text-xs font-bold uppercase tracking-widest text-brand-green">{item.focus}</p>}
                      {item.tag && <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-brand-green">{item.tag}</p>}
                      {bullets ? (
                        <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-600">
                          {bullets.map((b) => (
                            <li class="flex gap-2.5 transition-colors duration-200 group-hover:text-slate-700">
                              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                              </svg>
                              <span>{b}</span>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <div class="prose-basuka mt-3 text-sm leading-6 text-slate-600">
                          {paragraphs(item.body).map((p) => (
                            <p>{p}</p>
                          ))}
                        </div>
                      )}
                      {item.button && (
                        <a
                          href={item.button.href ?? '/contact-us/'}
                          class="link-sweep mt-5 inline-block text-sm font-bold text-brand-green-dark"
                        >
                          {item.button.label} →
                        </a>
                      )}
                    </div>
                  );
                })}
              </div>
              {section.ctas && (
                <div class="mt-10 text-center">
                  {section.ctas.map((cta) => (
                    <a href={cta.href ?? '/contact-us/'} class="btn-shine group inline-flex items-center gap-2 rounded-full bg-brand-green px-8 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-green/25 transition hover:bg-brand-green-dark">
                      {cta.label}
                      <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </section>
        );

      case 'steps':
        return (
          <section id={sectionId(section, idx)} data-steps class="bg-brand-cream-light py-20 lg:py-24">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
              {section.eyebrow && (
                <p class="eyebrow-rule mb-3 justify-center">
                  <span class="ghost-numeral text-xl">{nextEyebrowNumber()}</span>
                  {section.eyebrow}
                </p>
              )}
              {section.heading && (
                <h2 class="text-center text-3xl font-bold sm:text-4xl">
                  {accentify(section.heading).map((part) =>
                    part.accent ? <span class="accent-serif text-brand-green-dark">{part.text}</span> : part.text
                  )}
                </h2>
              )}
              {section.intro && <p class="mx-auto mt-4 max-w-3xl text-center text-lg leading-8 text-slate-600">{section.intro}</p>}
              <ol class="relative mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                <div class="steps-line pointer-events-none absolute top-14 right-8 left-8 hidden h-0.5 bg-gradient-to-r from-brand-green/10 via-brand-green/40 to-brand-green/10 lg:block" aria-hidden="true" />
                <div class="steps-progress pointer-events-none absolute top-14 left-8 hidden h-0.5 bg-gradient-to-r from-brand-green to-brand-cream lg:block" style="width: 0%" aria-hidden="true" />
                {section.items?.map((item, i) => (
                  <li class="reveal group relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-brand-navy/5 transition duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-brand-navy/5">
                    <span class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-brand-green font-display text-lg font-bold text-white shadow-md shadow-brand-green/30 transition-transform duration-300 group-hover:scale-110">
                      {item.number ?? String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
                    {Array.isArray(item.body) ? (
                      <ul class="mt-3 space-y-1.5 text-sm leading-6 text-slate-600">
                        {item.body.map((b: string) => (
                          <li class="flex gap-2">
                            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-green" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                            </svg>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
