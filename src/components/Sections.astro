<script>
  // Lead forms (contact, partnership, academy): compose the fields into a
  // pre-filled WhatsApp message and open it in a new tab, with a fallback link.
  document.querySelectorAll('form[data-whatsapp]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const number = form.getAttribute('data-whatsapp') ?? '12149951927';
      const context = form.getAttribute('data-context') ?? '';
      const fd = new FormData(form);
      const lines: string[] = [];
      if (context) lines.push(context);
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-label]').forEach((el) => {
        const label = el.getAttribute('data-label');
        let value = '';
        if (el instanceof HTMLSelectElement) {
          value = el.options[el.selectedIndex]?.text ?? '';
        } else {
          value = (fd.get(el.name)?.toString() ?? '').trim();
        }
        if (label && value) lines.push(`${label}: ${value}`);
      });
      const url = `https://wa.me/${number}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener');
      const successId = form.getAttribute('data-success');
      const success = successId ? document.getElementById(successId) : null;
      if (success) {
        const fallback = success.querySelector<HTMLAnchorElement>('a[data-fallback]');
        if (fallback) fallback.setAttribute('href', url);
        success.classList.remove('hidden');
        success.classList.add('flex');
      }
      form.reset();
    });
  });
</script>

<script>
  // Count-up animation for stat values, triggered on scroll.
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const animate = (el: Element) => {
    const target = parseFloat(el.getAttribute('data-target') ?? '0');
    const decimals = parseInt(el.getAttribute('data-decimals') ?? '0', 10);
    const start = performance.now();
    const dur = 1400;
    const tick = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      const val = target * ease(p);
      el.textContent = val.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const statObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target);
          statObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 }
  );
  document.querySelectorAll('.count-up').forEach((el) => statObserver.observe(el));
</script>

<script>
  // Animate the steps progress line based on scroll position through the steps section.
  const stepsSection = document.querySelector('section[data-steps]') as HTMLElement | null;
  const stepsProgress = document.querySelector('.steps-progress') as HTMLElement | null;
  if (stepsSection && stepsProgress) {
    const updateProgress = () => {
      const rect = stepsSection.getBoundingClientRect();
      const viewportH = window.innerHeight;
      // Start filling when section top enters viewport, fully filled when section bottom passes.
      const total = rect.height + viewportH * 0.5;
      const scrolled = viewportH * 0.5 - rect.top;
      const pct = Math.max(0, Math.min(1, scrolled / total));
      stepsProgress.style.width = (pct * 100).toFixed(1) + '%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  }
</script>
