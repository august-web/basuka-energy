---
import { t, type Lang, localizedHref } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const nav = [
  { key: 'home', href: '/' },
  { key: 'about', href: '/about-us-2/' },
  { key: 'partners', href: '/partners/' },
  { key: 'howItWorks', href: '/how-it-works/' },
  { key: 'academy', href: '/academy/' },
  { key: 'impact', href: '/impact/' },
  { key: 'contact', href: '/contact-us/' },
] as const;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/fr/' || path.startsWith('/fr') && href === '/' && path.replace(/^\/fr/, '/') === '/' : path.replace(/^\/fr/, '').startsWith(href);

const otherLang: 'fr' | 'en' = lang === 'en' ? 'fr' : 'en';
// Equivalent page in the other locale: swap the prefix, keep the rest of the path
const strippedPath = path.replace(/^\/fr(?=\/|$)/, '') || '/';
const altHref = otherLang === 'fr' ? '/fr' + (strippedPath === '/' ? '/' : strippedPath) : strippedPath;
---

<header id="site-header" class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur transition-shadow duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
    <a href={localizedHref('/', lang)} class="flex items-center gap-2" aria-label="BaSuka Energy home">
      <img src="/assets/logo.png" alt="BaSuka Energy logo" class="h-10 w-auto" width="160" height="40" decoding="async" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={ui.breadcrumbNav === 'Breadcrumb' ? 'Main' : 'Principal'}>
      {
        nav.map((item) => (
          <a
            href={localizedHref(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-brand-green/10 text-brand-green-dark'
                : 'text-slate-600 hover:bg-slate-50 hover:text-brand-navy',
            ]}
          >
            {ui.nav[item.key]}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-brand-green" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {/* Language switcher */}
      <div class="relative" id="lang-switcher">
        <button
          id="lang-toggle"
          class="flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-2 text-sm font-semibold text-brand-navy transition hover:border-brand-green/40 hover:text-brand-green-dark"
          aria-label={ui.switcherLabel}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path stroke-linecap="round" d="M2 12h20M12 2c2.7 2.7 4 6.2 4 10s-1.3 7.3-4 10c-2.7-2.7-4-6.2-4-10s1.3-7.3 4-10z" />
          </svg>
          <span class="uppercase">{lang}</span>
        </button>
        <div
          id="lang-menu"
          class="invisible absolute right-0 top-full z-50 mt-2 w-40 -translate-y-1 rounded-xl border border-slate-100 bg-white py-1 opacity-0 shadow-xl shadow-slate-200/60 transition-all duration-150"
          role="menu"
        >
          {
            (['en', 'fr'] as const).map((l) => (
              <a
                href={l === lang ? path : (l === 'fr' ? '/fr' : '') + (strippedPath === '/' ? '/' : strippedPath)}
                hreflang={l}
                lang={l}
                role="menuitem"
                aria-current={l === lang ? 'true' : undefined}
                class:list={[
                  'flex items-center justify-between px-4 py-2.5 text-sm transition-colors',
                  l === lang
                    ? 'bg-brand-green/10 font-bold text-brand-green-dark'
                    : 'text-slate-600 hover:bg-slate-50 hover:text-brand-navy',
                ]}
              >
                {l === 'en' ? 'English' : 'Français'}
                {l === lang && (
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={localizedHref('/contact-us/', lang)}
        class="hidden rounded-full bg-brand-green px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-green-dark lg:inline-block btn-shine"
      >
        {ui.getInTouch}
      </a>

      <button
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-brand-navy lg:hidden"
        aria-label={ui.menuToggle}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path id="icon-open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
          <path id="icon-close" class="hidden" stroke-linecap="round" d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="grid grid-rows-[0fr] overflow-hidden border-t border-slate-100 bg-white transition-all duration-300 ease-in-out lg:hidden">
    <div class="min-h-0 overflow-hidden">
      <nav class="px-4 pb-6 pt-2" aria-label={ui.breadcrumbNav === 'Breadcrumb' ? 'Mobile' : 'Mobile'}>
        {
          nav.map((item) => (
            <a
              href={localizedHref(item.href, lang)}
              class:list={[
                'block rounded-lg px-4 py-3 text-base font-medium',
                isActive(item.href) ? 'bg-brand-green/10 text-brand-green-dark' : 'text-slate-600 hover:bg-slate-50',
              ]}
            >
              {ui.nav[item.key]}
            </a>
          ))
        }
        <a href={localizedHref('/contact-us/', lang)} class="mt-3 block rounded-full bg-brand-green px-5 py-3 text-center text-sm font-semibold text-white">
          {ui.getInTouch}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  let isOpen = false;

  const setOpen = (open: boolean) => {
    isOpen = open;
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      menu?.classList.remove('grid-rows-[0fr]');
      menu?.classList.add('grid-rows-[1fr]');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      menu?.classList.remove('grid-rows-[1fr]');
      menu?.classList.add('grid-rows-[0fr]');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  };

  toggle?.addEventListener('click', () => setOpen(!isOpen));

  // --- Language switcher dropdown ---
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');
  let langOpen = false;

  const setLangOpen = (open: boolean) => {
    langOpen = open;
    langToggle?.setAttribute('aria-expanded', String(open));
    if (!langToggle || !langMenu) return;
    if (open) {
      langMenu.classList.remove('invisible', 'opacity-0', '-translate-y-1');
    } else {
      langMenu.classList.add('invisible', 'opacity-0', '-translate-y-1');
    }
  };

  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setLangOpen(!langOpen);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && langOpen) setLangOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (langOpen && langMenu && !langMenu.contains(e.target as Node)) setLangOpen(false);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });

  // Close on click outside the menu
  document.addEventListener('click', (e) => {
    if (!isOpen) return;
    const target = e.target as Node;
    if (menu && !menu.contains(target) && toggle && !toggle.contains(target)) {
      setOpen(false);
    }
  });

  // Close on nav link click (page transition)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen) setOpen(false);
  });

  // Scroll-aware header shadow
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (window.scrollY > 8) {
      header?.classList.add('shadow-md', 'shadow-slate-200/50');
    } else {
      header?.classList.remove('shadow-md', 'shadow-slate-200/50');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
