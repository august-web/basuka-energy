---
const nav = [
  { label: 'Home', href: '/' },
  { label: 'About us', href: '/about-us-2/' },
  { label: 'Partners', href: '/partners/' },
  { label: 'How it works', href: '/how-it-works/' },
  { label: 'Academy', href: '/academy/' },
  { label: 'Impact', href: '/impact/' },
  { label: 'Contact us', href: '/contact-us/' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header id="site-header" class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur transition-shadow duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2" aria-label="Ba-Suka Energy home">
      <img src="/assets/logo.png" alt="Ba-Suka Energy logo" class="h-10 w-auto" width="160" height="40" decoding="async" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-brand-green/10 text-brand-green-dark'
                : 'text-slate-600 hover:bg-slate-50 hover:text-brand-navy',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-brand-green" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <a
      href="/contact-us/"
      class="hidden rounded-full bg-brand-green px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-green-dark lg:inline-block btn-shine"
    >
      Get in touch
    </a>

    <button
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full text-brand-navy lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="icon-open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        <path id="icon-close" class="hidden" stroke-linecap="round" d="M6 6l12 12M6 18L18 6" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="grid grid-rows-[0fr] overflow-hidden border-t border-slate-100 bg-white transition-all duration-300 ease-in-out lg:hidden">
    <div class="min-h-0 overflow-hidden">
      <nav class="px-4 pb-6 pt-2" aria-label="Mobile">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block rounded-lg px-4 py-3 text-base font-medium',
                isActive(item.href) ? 'bg-brand-green/10 text-brand-green-dark' : 'text-slate-600 hover:bg-slate-50',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/contact-us/" class="mt-3 block rounded-full bg-brand-green px-5 py-3 text-center text-sm font-semibold text-white">
          Get in touch
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  let isOpen = false;

  const setOpen = (open: boolean) => {
    isOpen = open;
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      menu?.classList.remove('grid-rows-[0fr]');
      menu?.classList.add('grid-rows-[1fr]');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      menu?.classList.remove('grid-rows-[1fr]');
      menu?.classList.add('grid-rows-[0fr]');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  };

  toggle?.addEventListener('click', () => setOpen(!isOpen));

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });

  // Close on click outside the menu
  document.addEventListener('click', (e) => {
    if (!isOpen) return;
    const target = e.target as Node;
    if (menu && !menu.contains(target) && toggle && !toggle.contains(target)) {
      setOpen(false);
    }
  });

  // Close on nav link click (page transition)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen) setOpen(false);
  });

  // Scroll-aware header shadow
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (window.scrollY > 8) {
      header?.classList.add('shadow-md', 'shadow-slate-200/50');
    } else {
      header?.classList.remove('shadow-md', 'shadow-slate-200/50');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
