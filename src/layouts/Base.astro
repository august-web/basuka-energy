---
import '@fontsource-variable/outfit';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/600-italic.css';
import '../styles/global.css';
import { langFromPath, altPath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = langFromPath(Astro.url.pathname) } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altHref = altPath(Astro.url.pathname, lang === 'en' ? 'fr' : 'en');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#58a80a" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://maps.google.com" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? Astro.url.pathname : altHref, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(lang === 'fr' ? Astro.url.pathname : altHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(altPath(Astro.url.pathname, 'en'), Astro.site)} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="BaSuka Energy" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/favicon-270.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="google-site-verification" content="c6hdYqMC7jBJU34KbQZPmhYLK0ON0qpSmsH8yxS8X4Q" />
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'BaSuka Energy',
        url: 'https://basukaenergy.com',
        description: "Africa's sovereign energy platform — 130 MW of new dispatchable capacity, delivered through smart, swappable SIRA batteries and solar-first Swap & Glow stations.",
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Ouagadougou',
          addressCountry: 'BF',
        },
      })}
    />
    <script is:inline>
      // First-visit language detection: if the visitor's browser prefers French
      // and they haven't chosen a language yet, send them to /fr/.
      (function () {
        try {
          var path = location.pathname;
          var onFr = path === '/fr' || path.indexOf('/fr/') === 0;
          var choice = localStorage.getItem('lang');
          if (choice) return; // respect an explicit choice made in the switcher
          if (onFr) return;
          var lang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (lang && lang.toLowerCase().indexOf('fr') === 0) {
            localStorage.setItem('lang', 'fr'); // remember the auto-choice
            location.replace('/fr' + (path === '/' ? '/' : path));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot />
  </body>
</html>
