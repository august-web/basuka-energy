---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Sections from '../components/Sections.astro';
import Subnav from '../components/Subnav.astro';

interface Props {
  data: { title: string; metaDescription: string; sections: any[] };
}
const { data } = Astro.props;
const heroSections = data.sections.filter((s: any) => s.type === 'hero');
const contentSections = data.sections.filter((s: any) => s.type !== 'hero');
---

<Base title={data.title} description={data.metaDescription}>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-navy focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
    Skip to content
  </a>
  <div class="scroll-progress" style="width: 0%" aria-hidden="true"></div>
  <Header />
  <main id="main-content">
    <Sections sections={data.sections} />
  </main>
  <Footer />
  <WhatsAppFloat />
  <button
    id="back-to-top"
    class="fixed bottom-5 left-5 z-50 flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-brand-navy shadow-lg shadow-slate-200/50 opacity-0 pointer-events-none transition-all duration-300 hover:scale-105 hover:border-brand-green/30 hover:text-brand-green-dark"
    aria-label="Back to top"
  >
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  {/* Floating share buttons */}
  <div id="share-bar" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2">
    <button
      id="share-toggle"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-navy text-white shadow-lg shadow-brand-navy/20 transition hover:scale-105"
      aria-label="Share this page"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.7 10.7a3 3 0 0 0-1.6-1.3 3 3 0 1 0-1.5 2.6l3.1 5.3a3 3 0 1 0 3-1.8l-3-5.2a3 3 0 0 0 0 .4zM18 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
      </svg>
    </button>
    <div id="share-links" class="flex flex-col gap-2 opacity-0 pointer-events-none transition-all duration-300" style="max-height:0;overflow:hidden">
      <a data-share="linkedin" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#0a66c2] shadow-md border border-slate-100 transition hover:scale-105" aria-label="Share on LinkedIn">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.3 18.3V10H5.7v8.3h2.6zM7 8.8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm11.3 9.5v-4.5c0-2.4-1.3-3.5-3-3.5-1.4 0-2 .8-2.3 1.3v-1.1h-2.6v8.3h2.6v-4.6c0-.9.2-1.7 1.3-1.7s1.1 1 1.1 1.7v4.6h2.6z" /></svg>
      </a>
      <a data-share="facebook" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#1877f2] shadow-md border border-slate-100 transition hover:scale-105" aria-label="Share on Facebook">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.8h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z" /></svg>
      </a>
      <a data-share="whatsapp" target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#25d366] shadow-md border border-slate-100 transition hover:scale-105" aria-label="Share on WhatsApp">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1s-.5-.2-.7.2-.8 1-.9 1.1-.3.2-.6 0c-1.5-.7-2.4-1.3-3.4-3-.3-.5.3-.5.7-1.5.1-.2 0-.4 0-.5L9.4 7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.8.4C7 7 6 8 6 10c0 2.3 1.7 4.5 1.9 4.8.2.3 3.3 5 8 7 1.2.5 2 .8 2.7.9.6.1 1.2.1 1.6 0 .5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.3A10 10 0 1 0 12 2z" /></svg>
      </a>
      <button data-share="copy" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-brand-navy shadow-md border border-slate-100 transition hover:scale-105" aria-label="Copy link">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.8 6.3a4 4 0 0 0-5.6 0l-3 3a4 4 0 0 0 5.5 5.6l1-1" /><path stroke-linecap="round" stroke-linejoin="round" d="M10.2 17.7a4 4 0 0 0 5.6 0l3-3a4 4 0 0 0-5.5-5.6l-1 1" /></svg>
      </button>
    </div>
  </div>

  {/* Image lightbox modal */}
  <div id="lightbox" class="fixed inset-0 z-[90] hidden items-center justify-center bg-brand-navy/90 backdrop-blur-sm p-4">
    <button id="lightbox-close" class="absolute right-4 top-4 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20" aria-label="Close image">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" /></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] rounded-2xl shadow-2xl ring-1 ring-white/20" />
  </div>

  {/* Cookie consent banner */}
  <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[80] hidden border-t border-slate-200 bg-white/95 backdrop-blur p-4 shadow-lg sm:p-6">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <p class="text-sm leading-6 text-slate-600">
        We use cookies to improve your experience and analyze site traffic. By continuing, you agree to our use of cookies.
      </p>
      <div class="flex shrink-0 gap-3">
        <button id="cookie-reject" class="rounded-full border border-slate-200 px-5 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">Decline</button>
        <button id="cookie-accept" class="rounded-full bg-brand-green px-6 py-2 text-sm font-bold text-white transition hover:bg-brand-green-dark">Accept</button>
      </div>
    </div>
  </div>
  <script>
    // Scroll progress bar + back-to-top button visibility
    const progress = document.querySelector('.scroll-progress') as HTMLElement;
    const backToTop = document.getElementById('back-to-top');
    const onScroll = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      if (progress) progress.style.width = `${pct}%`;
      if (backToTop) {
        if (scrollTop > 600) {
          backToTop.classList.remove('opacity-0', 'pointer-events-none');
          backToTop.classList.add('opacity-100');
        } else {
          backToTop.classList.add('opacity-0', 'pointer-events-none');
          backToTop.classList.remove('opacity-100');
        }
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Scroll reveal IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal, .fade-in').forEach((el) => observer.observe(el));

    // --- Image lightbox ---
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');
    const openLightbox = (src: string, alt: string) => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    };
    document.querySelectorAll('.lightbox-trigger').forEach((el) => {
      el.addEventListener('click', () => {
        const img = el.querySelector('img') ?? el;
        openLightbox((img as HTMLImageElement).src, (img as HTMLImageElement).alt);
      });
    });
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox || e.target === lightboxClose) closeLightbox(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

    // --- Cookie consent ---
    const cookieBanner = document.getElementById('cookie-banner');
    const cookieAccept = document.getElementById('cookie-accept');
    const cookieReject = document.getElementById('cookie-reject');
    if (cookieBanner && !localStorage.getItem('cookie-consent')) {
      cookieBanner.classList.remove('hidden');
    }
    const setConsent = (val: string) => {
      localStorage.setItem('cookie-consent', val);
      cookieBanner?.classList.add('hidden');
    };
    cookieAccept?.addEventListener('click', () => setConsent('accepted'));
    cookieReject?.addEventListener('click', () => setConsent('rejected'));

    // --- Floating share bar ---
    const shareToggle = document.getElementById('share-toggle');
    const shareLinks = document.getElementById('share-links');
    let shareOpen = false;
    const toggleShare = (open: boolean) => {
      shareOpen = open;
      shareToggle?.setAttribute('aria-expanded', String(open));
      if (shareLinks) {
        if (open) {
          shareLinks.classList.remove('opacity-0', 'pointer-events-none');
          shareLinks.style.maxHeight = '400px';
        } else {
          shareLinks.classList.add('opacity-0', 'pointer-events-none');
          shareLinks.style.maxHeight = '0';
        }
      }
    };
    shareToggle?.addEventListener('click', () => toggleShare(!shareOpen));
    const pageUrl = window.location.href;
    const pageTitle = document.title;
    shareLinks?.querySelectorAll('[data-share]').forEach((btn) => {
      const type = btn.getAttribute('data-share');
      const link = btn as HTMLAnchorElement;
      if (type === 'linkedin') link.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
      if (type === 'facebook') link.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
      if (type === 'whatsapp') link.href = `https://wa.me/?text=${encodeURIComponent(pageTitle + ' ' + pageUrl)}`;
      if (type === 'copy') {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          try { await navigator.clipboard.writeText(pageUrl); } catch {}
          const span = btn.querySelector('span');
          if (span) { span.textContent = 'Copied!'; setTimeout(() => span.textContent = '', 1500); }
        });
      }
    });
  </script>
</Base>
